# ==========================================================================
# Template for local secrets.  Copy to .env, fill in, then load before a run:
#     cp .env.example .env
#     set -a; source .env; set +a
#     ./.venv/bin/python run_bakeoff.py --once
# The harness does not auto-load .env — you must source it.
# ==========================================================================

# --- Agent CLIs (OPTIONAL) ------------------------------------------------
# claude + cursor-agent use their own OAuth login by default (Claude Keychain,
# ~/.cursor).  Set these ONLY for headless / CI / another-account runs — an
# empty value sourced into the shell overrides and breaks the OAuth login.
# ANTHROPIC_API_KEY=sk-ant-...
# CURSOR_API_KEY=...

# --- Postgres target (OPTIONAL) -------------------------------------------
# Overrides targets.postgres.dsn; defaults to postgresql:///bakeoff.
# BAKEOFF_PG_DSN=postgresql:///bakeoff

# --- Snowflake target (only when run.target: snowflake) -------------------
# https://signup.snowflake.com — 30-day free trial, $400 credits
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=BAKEOFF
